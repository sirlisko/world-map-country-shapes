{
  "name": "world-map-country-shapes",
  "version": "2.0.0",
  "description": "SVG path shapes for 210 countries and territories, keyed by ISO code, plus the boxes to zoom to each one. Framework-agnostic and dependency-free.",
  "keywords": [
    "world-map",
    "map",
    "svg",
    "countries",
    "country",
    "shapes",
    "paths",
    "geography",
    "iso-3166",
    "choropleth",
    "react",
    "robinson-projection"
  ],
  "homepage": "https://github.com/sirlisko/world-map-country-shapes#readme",
  "bugs": {
    "url": "https://github.com/sirlisko/world-map-country-shapes/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sirlisko/world-map-country-shapes.git"
  },
  "license": "MIT",
  "author": "Luca Lischetti <luca@sirlisko.com> (https://sirlisko.com)",
  "type": "module",
  "sideEffects": false,
  "main": "index.js",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./bounds": {
      "types": "./bounds.d.ts",
      "default": "./bounds.js"
    },
    "./world-map.svg": "./world-map.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "bounds.js",
    "bounds.d.ts",
    "world-map.svg"
  ],
  "scripts": {
    "generate": "node scripts/bounds.js && node scripts/svg.js",
    "test": "node --test",
    "prepublishOnly": "npm test"
  }
}
